pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID = sh(script: "aws sts get-caller-identity --query Account --output text", returnStdout: true).trim()
        AWS_REGION     = "us-east-1"
        GIT_REPO_NAME  = "ecommerce-microservices-aws-eks"
        GIT_USER_NAME  = "JudeCodeHub"
        GIT_EMAIL      = "JudeCodeHub@users.noreply.github.com"
        GIT_BRANCH     = "main"
    }

    stages {
        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: "${GIT_BRANCH}", url: "https://github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git"
            }
        }

        stage('Build - adservice') {
            steps {
                dir('src/adservice') {
                    sh 'docker system prune -f'
                    sh 'docker container prune -f'
                    sh "docker build -t adservice ."
                }
            }
        }

        stage('Push to ECR - adservice') {
            steps {
                sh """
                    aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                    docker tag adservice:latest ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/adservice:${BUILD_NUMBER}
                    docker push ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/adservice:${BUILD_NUMBER}
                """
            }
        }

        stage('Update Deployment - adservice') {
            steps {
                dir('kubernetes-files') {
                    withCredentials([string(credentialsId: 'my-git-pattoken', variable: 'git_token')]) {
                        sh """
                            git config user.email "${GIT_EMAIL}"
                            git config user.name "${GIT_USER_NAME}"
                            sed -i "s#image:.*#image: ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/adservice:${BUILD_NUMBER}#g" adservice.yaml
                            git add adservice.yaml
                            git commit -m "Update adservice image to version ${BUILD_NUMBER}" || echo "No changes to commit"
                            git pull origin ${GIT_BRANCH} --rebase
                            git push https://${git_token}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:${GIT_BRANCH}
                        """
                    }
                }
            }
        }

